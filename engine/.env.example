# ============================================================
# TalentFinder Sales Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#   nano .env
# ============================================================

# --- Anthropic (Claude AI) — primary provider ---
ANTHROPIC_API_KEY=sk-ant-api03-PASTE-YOUR-KEY-HERE

# --- AI model routing (provider-agnostic layer, see modules/llm.py) ---
# Primary + cheaper/faster model used by cost-saving routes.
LLM_MODEL=claude-sonnet-4-6
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# Optional backup / cheaper provider. Leave OPENAI_API_KEY blank to run
# Anthropic-only. Set OPENAI_BASE_URL to use any OpenAI-compatible API
# (OpenRouter, Groq, DeepSeek, Together, Google OpenAI-compat, local Ollama).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Per-call timeout (seconds) and transient-error retries before failover.
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# --- Per-task model routing (all OPTIONAL) -------------------------------
# Comma-separated "provider:model" candidates, tried left to right. A
# candidate is skipped if its provider has no key, so the same .env works
# with or without a backup configured.
#
# Defaults (when these are unset) keep EVERY task on the primary Claude model
# — identical quality to today — and add OpenAI as automatic backup only if
# OPENAI_API_KEY is set. Override to save money on bulk tasks, e.g.:
#
#   LLM_ROUTE_CLASSIFY=anthropic:claude-haiku-4-5-20251001, openai:gpt-4o-mini
#   LLM_ROUTE_RESEARCH=openai:gpt-4o-mini, anthropic:claude-sonnet-4-6
#   LLM_ROUTE_REPLY=anthropic:claude-sonnet-4-6, openai:gpt-4o
#   LLM_ROUTE_DEFAULT=anthropic:claude-sonnet-4-6, openai:gpt-4o
#
# Tasks: classify, reply, objection, draft, brief, research
#LLM_ROUTE_CLASSIFY=
#LLM_ROUTE_REPLY=
#LLM_ROUTE_OBJECTION=
#LLM_ROUTE_DRAFT=
#LLM_ROUTE_BRIEF=
#LLM_ROUTE_RESEARCH=
#LLM_ROUTE_DEFAULT=

